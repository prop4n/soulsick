# Only needed with docker-compose.vpn.yml (ProtonVPN through gluetun). Copy to .env and fill.

# WireGuard private key from https://account.protonvpn.com/downloads
# (WireGuard configuration, platform "Router", with "NAT-PMP (Port Forwarding)" ON)
PROTON_WIREGUARD_KEY=

# Countries to pick a P2P server from (comma separated)
PROTON_COUNTRIES=Switzerland,Netherlands

TZ=Europe/Paris
